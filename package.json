{
  "name": "cms-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run i18n:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:subscriptions && npm run test:media",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:rls": "node scripts/run-rls-tests.mjs",
    "test:e2e": "node scripts/run-firefox-e2e.mjs",
    "test:e2e:firefox": "node scripts/run-firefox-e2e.mjs",
    "test:e2e:brave": "node scripts/run-brave-e2e.mjs",
    "test:e2e:all": "node scripts/run-firefox-e2e.mjs && node scripts/run-brave-e2e.mjs",
    "test:all": "npm test && npm run test:rls && npm run test:e2e:all",
    "test:media": "node --import tsx --test tests/media/image-normalization.test.mjs",
    "test:subscriptions": "node --import tsx --test tests/subscriptions/entitlements.test.mjs"
  },
  "dependencies": {

    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.3.0",
    "next-intl": "4.13.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.12.0",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
